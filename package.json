{
  "name": "dzj-sync",
  "version": "3.0.0",
  "private": true,
  "description": "Markdown 多平台同步（精简版）- 上传 Markdown 文档，一键同步草稿或直接发布到多个平台",
  "scripts": {
    "dev": "pnpm --filter @wechatsync/extension dev",
    "build": "pnpm --filter @wechatsync/extension build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint packages --ext .ts,.tsx",
    "clean": "pnpm -r clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.55.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
