{
  "name": "@wechatsync/core",
  "version": "2.0.0",
  "description": "DZJ Sync 核心逻辑 - Markdown 解析、平台适配器、运行时抽象",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    },
    "./adapters": {
      "types": "./src/adapters/index.ts",
      "import": "./src/adapters/index.ts",
      "require": "./src/adapters/index.ts"
    },
    "./runtime": {
      "types": "./src/runtime/index.ts",
      "import": "./src/runtime/index.ts",
      "require": "./src/runtime/index.ts"
    }
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "js-md5": "^0.8.3",
    "juice": "^11.1.0",
    "markdown-draft-js": "^2.4.0",
    "marked": "^17.0.1",
    "remarkable": "^2.0.1",
    "turndown": "^7.2.2",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@types/remarkable": "^2.0.8",
    "@types/turndown": "^5.0.6",
    "tsup": "^8.0.1",
    "vitest": "^1.1.0"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  }
}
