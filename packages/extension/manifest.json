{
  "manifest_version": 3,
  "name": "Markdown 多平台同步",
  "description": "上传 Markdown 文档，一键保存草稿或直接发布到掘金、CSDN、知乎、博客园、语雀、WordPress 等平台，支持 CLI / MCP / Claude Skill",
  "version": "3.0.0",
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_icon": "assets/icon-48.png",
    "default_title": "Markdown 多平台同步"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "cookies",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "offscreen",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  }
}
